{
  "name": "easy-dunya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Easy Dunya - Plateforme digitale de transport interurbain en Mauritanie",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-native-icons.mjs && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-native-icons.mjs",
    "native-icons": "node scripts/make-native-icons.mjs && npx capacitor-assets generate --android",
    "vapid": "node scripts/generate-vapid.mjs",
    "test:route": "node scripts/test-route-remaining.mjs",
    "test:directions": "node scripts/test-google-directions.mjs",
    "test:trip-end": "node scripts/test-trip-end-simulation.mjs",
    "test:gps-rpc": "node scripts/test-driver-gps-rpc.mjs",
    "test:e2e:cleanup": "node scripts/e2e/0-cleanup-driver.mjs",
    "test:e2e:create": "node scripts/e2e/1-create-trip.mjs",
    "test:e2e:start": "node scripts/e2e/2-start-trip.mjs",
    "test:e2e:gps-aleg": "node scripts/e2e/3-position-driver-dest.mjs",
    "test:e2e:gps-dest": "node scripts/e2e/3-position-driver-dest.mjs",
    "test:e2e:verify": "node scripts/e2e/4-verify-end-trip.mjs",
    "test:e2e:all": "node scripts/e2e/run-all.mjs",
    "test:e2e:route": "node scripts/e2e/run-route.mjs",
    "test:e2e:nkc-arafat": "node scripts/e2e/run-route.mjs --from=nouakchott --to=arafat",
    "test:e2e:nkc-tevragh": "node scripts/e2e/run-route.mjs --from=nouakchott --to=tevragh",
    "test:e2e:arafat-tevragh": "node scripts/e2e/run-route.mjs --from=arafat --to=tevrag_zeina",
    "postinstall": "node scripts/make-native-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "^8.0.2",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.107.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "leaflet": "^1.9.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-window": "^7.1.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "replace": {
      "minimatch": "^3.1.5"
    }
  }
}
